# サーバー基本設定
HOST=0.0.0.0
PORT=8443
NODE_ENV=development
LOG_LEVEL=info

# セッション/JWT (本番では必ずランダムな長い文字列に変更する)
JWT_SECRET=change-me-in-production
SESSION_TTL_MINUTES=30

# クライアント⇔ノード間の暫定認証(V1)用アクセストークン。
# 空のままにすると初回起動時に自動生成され、ログと data/access-token.txt に出力される。
API_ACCESS_TOKEN=

# WebAuthn (パスキー) 設定。ノードごとに個別のrpID/originを設定する
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Harukoto Server Manager
WEBAUTHN_ORIGIN=https://localhost:8443

# Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock

# モニタリング履歴(SQLite: data/monitoring-history.db)
MONITORING_SAMPLE_INTERVAL_MS=15000
MONITORING_HISTORY_RETENTION_DAYS=14

# Pterodactylパネル連携 (Minecraft/ゲームサーバー管理モジュール)
PTERODACTYL_PANEL_URL=
PTERODACTYL_APPLICATION_API_KEY=
PTERODACTYL_CLIENT_API_KEY=

# Discord Webhook通知
DISCORD_WEBHOOK_URL=
