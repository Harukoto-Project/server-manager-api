{
  "name": "server-manager-api",
  "version": "0.1.0",
  "private": true,
  "description": "Harukoto Project Server Manager - node agent backend (REST + WebSocket)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/websocket": "^11.0.2",
    "@simplewebauthn/server": "^13.1.1",
    "better-sqlite3": "^13.0.2",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.34",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
